{
  "name": "montsong",
  "version": "1.0.0",
  "private": true,
  "description": "A fast, minimal music and ringtone library powered by Telegram-backed storage.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed.ts",
    "admin:password": "node --experimental-strip-types --no-warnings scripts/hash-password.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "auth:secret": "node --experimental-strip-types --no-warnings scripts/generate-secret.ts",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "busboy": "1.6.0",
    "next": "16.3.4",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "1.5.4",
    "@types/node": "22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
