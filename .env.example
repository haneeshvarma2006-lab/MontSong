# ---------------------------------------------------------------------------
# MontSong — environment configuration
#
# Copy to `.env` for local development, or set these as real environment
# variables in production. NEVER commit a filled-in .env.
# Every value below is a placeholder. See docs/TELEGRAM_SETUP.md for how to
# obtain the Telegram values and docs/DEPLOYMENT.md for the production setup.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# SQLite file path, relative to the project root. In production point this at
# a path on the persistent volume, e.g. file:/data/montsong.db
DATABASE_URL="file:./data/montsong.db"

# --- Telegram storage ------------------------------------------------------
# Bot token from @BotFather. Server-side only — never referenced from client
# code, never sent to the browser.
TELEGRAM_BOT_TOKEN="123456789:AAExampleExampleExampleExampleExample"

# Numeric id of the PRIVATE channel (or group) the bot posts media into.
# Supergroup/channel ids are negative and start with -100.
TELEGRAM_STORAGE_CHAT_ID="-1001234567890"

# Optional. Base URL of a self-hosted Bot API server (github.com/tdlib/telegram-bot-api).
# Leave unset to use Telegram's cloud Bot API.
#   unset  -> uploads and downloads are capped at 20 MB (see docs/ARCHITECTURE.md)
#   set    -> uploads up to 2000 MB, downloads with no size limit
# TELEGRAM_API_BASE_URL="http://127.0.0.1:8081"

# Optional. Set to "true" only when TELEGRAM_API_BASE_URL points at a local
# Bot API server started with --local, where getFile returns absolute paths on
# this machine's filesystem instead of a downloadable relative path.
# TELEGRAM_API_LOCAL_MODE="false"

# --- Admin (single owner) --------------------------------------------------
# Username the owner logs in with.
ADMIN_USERNAME="owner"
# scrypt hash of the owner's password. Generate with:  npm run admin:password
# Format: scrypt$N$r$p$<salt-b64>$<hash-b64>
ADMIN_PASSWORD_HASH="scrypt$16384$8$1$REPLACE_ME$REPLACE_ME"

# 32+ random bytes, base64. Used to sign session cookies and derive CSRF
# tokens. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="REPLACE_ME_WITH_48_RANDOM_BYTES_BASE64"

# --- Site ------------------------------------------------------------------
# Public origin, used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MontSong"

# --- Media cache -----------------------------------------------------------
# Directory for the on-disk media cache. Must live on the persistent volume.
MEDIA_CACHE_DIR="./media-cache"
# Total cache budget in bytes (default 2 GiB). Least-recently-used files are
# evicted once the budget is exceeded.
MEDIA_CACHE_MAX_BYTES="2147483648"
# Files larger than this are streamed straight through from Telegram instead
# of being cached (default 64 MiB).
MEDIA_CACHE_MAX_FILE_BYTES="67108864"

# Directory used to spool incoming uploads before they are handed to Telegram.
UPLOAD_TMP_DIR="./tmp-uploads"

# --- Limits ----------------------------------------------------------------
# Hard ceiling on an uploaded audio file, in bytes. Cannot exceed the ceiling
# imposed by the Telegram mode in use (20 MB cloud / 2000 MB local server);
# the app clamps it at startup and logs when it does.
MAX_AUDIO_UPLOAD_BYTES="20971520"
# Hard ceiling on an uploaded cover image, in bytes (default 5 MiB).
MAX_IMAGE_UPLOAD_BYTES="5242880"

# --- Optional --------------------------------------------------------------
# Comma-separated extra origins allowed to POST to the admin API. Normally
# empty: same-origin requests are always allowed.
# ADDITIONAL_TRUSTED_ORIGINS=""
# Set to "true" to log every Telegram API call (method + status, never the token).
# TELEGRAM_DEBUG="false"
